{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"outDir": "./dist",
		"rootDir": "./src",
		"composite": true,
		"noEmit": false,
		"verbatimModuleSyntax": false,
		"tsBuildInfoFile": "./.tsbuildinfo"
	},
	"include": ["src/**/*"],
	"references": [
		{ "path": "../appservice" },
		{ "path": "../core" },
		{ "path": "../room" }
	],
	"exclude": ["node_modules", "dist", "**/*.spec.ts", "**/*.test.ts"]
}
